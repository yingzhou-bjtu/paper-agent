# paper-agent 环境配置模板
# 复制为 .env 后填写，或运行: ./bin/setup-env  (Linux) / .\bin\setup-env.ps1  (Windows)
# 路径尽量使用相对路径（相对仓库根）或 ~/ 形式，避免机器绑定的绝对路径

# --- 项目根目录（留空 = 自动检测为仓库根）---
PAPER_AGENT_ROOT=

# --- Cursor 路径（留空则自动检测）---
CURSOR_USER_DATA_DIR=
CURSOR_EXTENSIONS_DIR=

# --- Overleaf 服务器 ---
OVERLEAF_SERVER_NAME=www.overleaf.com
OVERLEAF_SERVER_URL=https://www.overleaf.com/

# --- 你的 Overleaf 项目（必填）---
# 项目名称：Overleaf 网页上显示的名称
# 项目 ID：URL 中 /project/<ID> 一段
OVERLEAF_PROJECT_NAME=
OVERLEAF_PROJECT_ID=
OVERLEAF_USER_EMAIL=

# --- Overleaf Cookie 登录（www.overleaf.com 必填）---
OVERLEAF_COOKIE=

# --- 本地工作目录 ---
# Method A：推荐 ~/papers/<项目名>/method-a（留空且有项目名时自动推导）
OVERLEAF_METHOD_A_DIR=

# 相对仓库根目录
REFERENCES_DIR=参考文献
EXPERIMENT_CODE_DIR=实验代码

# --- 文献检索 API（可选）---
OPENALEX_POLITE_EMAIL=
CROSSREF_POLITE_EMAIL=
S2_API_KEY=
