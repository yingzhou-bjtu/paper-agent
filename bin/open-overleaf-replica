#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../scripts/lib/load-env.sh
source "$ROOT/scripts/lib/load-env.sh"
if [[ -n "${OVERLEAF_METHOD_A_DIR:-}" ]]; then
  REPLICA_DIR="$OVERLEAF_METHOD_A_DIR"
elif [[ -n "${OVERLEAF_PROJECT_NAME:-}" ]]; then
  REPLICA_DIR="$HOME/papers/$OVERLEAF_PROJECT_NAME/method-a"
else
  REPLICA_DIR="$HOME/papers/method-a"
fi
exec cursor -r "$REPLICA_DIR" "$@"
